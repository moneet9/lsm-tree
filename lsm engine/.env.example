AWS_ACCESS_KEY_ID=YOUR_REAL_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_REAL_SECRET_KEY
AWS_REGION=ap-south-1
S3_BUCKET=uploads
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# WAL and SSTables are cached locally and mirrored to this S3-compatible store when configured.
LSM_DATA_DIR=./data
LSM_PORT=8080
MEMTABLE_SIZE_MB=64
WAL_FLUSH_THRESHOLD_MB=128
BLOCK_SIZE_KB=4
BLOCK_CACHE_SIZE_MB=256
BLOOM_FPP=0.01
L0_COMPACTION_TRIGGER=4
MAX_LEVELS=3
WRITE_BUFFER_COUNT=2
COMPACTION_POLICY=size-tiered
