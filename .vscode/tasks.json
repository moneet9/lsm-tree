{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build LSM server (C++20)",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-O2",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "${workspaceFolder}/lsm engine/src/main.cpp",
                "-I",
                "${workspaceFolder}/lsm engine/include",
                "-lws2_32",
                "-lbcrypt",
                "-o",
                "${workspaceFolder}/lsm engine/lsm_server_cpp20.exe"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}",
                    "MSYSTEM": "UCRT64",
                    "MSYS2_PATH_TYPE": "inherit"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run LSM server",
            "type": "process",
            "command": "${workspaceFolder}/lsm engine/lsm_server_cpp20.exe",
            "dependsOn": "Build LSM server (C++20)",
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}",
                    "LSM_PORT": "8080",
                    "LSM_DATA_DIR": "${workspaceFolder}/lsm engine/data"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++20",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "${file}",
                "-lws2_32",
                "-lbcrypt",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
